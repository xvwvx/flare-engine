<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputType>Exe</OutputType>
    <RootNamespace>FlareEngine</RootNamespace>
    <StartupObject>FlareEngine.Program</StartupObject>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SDL3-CS" Version="3.4.12.3" />
    <PackageReference Include="Stride.Core.Mathematics" Version="4.3.0.2507" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <PackageReference Include="SDL3-CS.Windows" Version="3.4.12.1" />
    <PackageReference Include="SDL3-CS.Windows.Image" Version="3.4.4.7" />
    <PackageReference Include="SDL3-CS.Windows.TTF" Version="3.2.2.7" />
    <PackageReference Include="SDL3-CS.Windows.Mixer" Version="3.2.4.7" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <PackageReference Include="SDL3-CS.Linux" Version="3.4.12.1" />
    <PackageReference Include="SDL3-CS.Linux.Image" Version="3.4.4.7" />
    <PackageReference Include="SDL3-CS.Linux.TTF" Version="3.2.2.7" />
    <PackageReference Include="SDL3-CS.Linux.Mixer" Version="3.2.4.7" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <PackageReference Include="SDL3-CS.MacOS" Version="3.4.12.1" />
    <PackageReference Include="SDL3-CS.MacOS.Image" Version="3.4.4.7" />
    <PackageReference Include="SDL3-CS.MacOS.TTF" Version="3.2.2.7" />
    <PackageReference Include="SDL3-CS.MacOS.Mixer" Version="3.2.4.7" />
  </ItemGroup>

</Project>
